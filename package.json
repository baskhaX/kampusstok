{
  "name": "kampusstok",
  "version": "1.0.0",
  "description": "Açık Kaynak Üniversite & Kurum Kırtasiye Talep, Depo ve Envanter Yönetim Portalı",
  "type": "module",
  "main": "src/server.js",
  "license": "MIT",
  "keywords": [
    "kampus",
    "kirtasiye-talep",
    "stok-yonetimi",
    "depo-envanter",
    "open-source",
    "kurumsal-cozum"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "seed": "node --env-file=.env src/db/seed.js",
    "test": "node --test --env-file=.env tests/**/*.test.js",
    "backup": "node --env-file=.env -e \"import('./src/services/yedekService.js').then(m => m.default.yedekAl())\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  }
}
